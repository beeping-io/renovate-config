{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default Renovate preset for all Beeping ecosystem repos",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":automergeMinor",
    ":automergePatch",
    "group:allNonMajor",
    "schedule:earlyMondays",
    ":maintainLockFilesWeekly"
  ],
  "labels": ["chore", "supply-chain"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 3,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "supply-chain"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group all @types/* packages",
      "matchPackagePatterns": ["^@types/"],
      "groupName": "type-definitions"
    },
    {
      "description": "Group all testing-related packages",
      "matchPackagePatterns": [
        "jest",
        "vitest",
        "mocha",
        "chai",
        "sinon",
        "testing-library",
        "playwright",
        "cypress",
        "msw"
      ],
      "groupName": "testing-tools"
    },
    {
      "description": "Group all lint/format packages",
      "matchPackagePatterns": [
        "eslint",
        "prettier",
        "stylelint",
        "commitlint",
        "lint-staged"
      ],
      "groupName": "lint-and-format"
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
